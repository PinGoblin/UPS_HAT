from typing import Any, Callable, Dict, List, Optional, Tuple, TypeVar

from .battery import BatteryMonitor
from .bq25798 import ADCReading, BQ25798
from .bus import I2CBus
from .faults import Fault
from .pimon import PiPower
from .stusb4500 import STUSB4500, Contract

_F = TypeVar("_F", bound=Callable[[Fault], Any])

FACTORY_PDOS: Tuple[Tuple[float, float], ...]
STANDARD_PD_VOLTAGES: Tuple[float, ...]
CHARGE_VOLTAGE_RANGE: Tuple[float, float]
CHARGE_CURRENT_MAX: float
INPUT_CURRENT_MAX: float
OUTPUT_POWER_LIMIT: float
CHARGER_EFFICIENCY: float
OUTPUT_EFFICIENCY: float

class Snapshot:
    time: Optional[float]
    wall_time: Optional[float]
    charger_ok: bool
    pd_ok: bool
    adc: Optional[ADCReading]
    vbus: Optional[float]
    ibus: Optional[float]
    vbat: Optional[float]
    ibat: Optional[float]
    vsys: Optional[float]
    tdie: Optional[float]
    ts_pct: Optional[float]
    status: Dict[str, Any]
    charger_faults: List[str]
    flags: Dict[str, List[str]]
    adapter_present: bool
    power_good: bool
    on_battery: bool
    charging: bool
    charge_state: Optional[int]
    charge_state_text: str
    battery_present: bool
    soc: Optional[float]
    remaining_mah: Optional[float]
    capacity_mah: Optional[float]
    time_to_empty_h: Optional[float]
    time_to_full_h: Optional[float]
    battery_resistance: Optional[float]
    input_power: Optional[float]
    battery_power: Optional[float]
    output_power: Optional[float]
    pd: Dict[str, Any]
    contract: Optional[Contract]
    contract_voltage: Optional[float]
    contract_current: Optional[float]
    pi: Dict[str, Any]
    faults: List[Fault]
    new_faults: List[Fault]
    cleared_faults: List[Fault]
    should_shutdown: bool
    def __init__(self) -> None: ...
    def fault_codes(self) -> List[str]: ...
    def worst_severity(self) -> int: ...
    def to_dict(self) -> Dict[str, Any]: ...

class UPS:
    i2c: I2CBus
    cells_parallel: int
    target_charge_voltage: float
    target_charge_current: float
    ship_fet: bool
    state_file: Optional[str]
    low_battery_soc: float
    low_battery_voltage: float
    auto_configure: bool
    protect: bool
    charger: Optional[BQ25798]
    pd: Optional[STUSB4500]
    battery: BatteryMonitor
    pi: Optional[PiPower]
    def __init__(
        self,
        i2c: Optional[I2CBus] = None,
        cells_parallel: int = 1,
        cell_capacity_mah: float = 3000.0,
        charge_voltage: float = 8.2,
        charge_current: Optional[float] = None,
        ship_fet: bool = True,
        state_file: Optional[str] = None,
        low_battery_soc: float = 5.0,
        low_battery_voltage: float = 6.2,
        auto_configure: bool = True,
        protect: bool = True,
        pi_monitor: bool = True,
        bus: int = 1,
    ) -> None: ...
    def _connect(self) -> None: ...
    def _need_charger(self) -> BQ25798: ...
    def _need_pd(self) -> STUSB4500: ...
    def configure(self) -> None: ...
    def _settings_lost(self) -> bool: ...
    def sync_input_current_limit(self) -> Optional[float]: ...
    @property
    def charging_enabled(self) -> bool: ...
    def enable_charging(self, on: bool = True) -> None: ...
    def set_charge_voltage(self, volts: float) -> None: ...
    def set_charge_current(self, amps: float) -> None: ...
    def set_input_current_limit(self, amps: float) -> None: ...
    def _need_ship_fet(self) -> BQ25798: ...
    def ship_mode(self, delay: bool = False) -> None: ...
    def shutdown_mode(self, delay: bool = False) -> None: ...
    def system_reset(self, delay: bool = False) -> None: ...
    def power_off(self, low_battery: Optional[bool] = None) -> str: ...
    def renegotiate_pd(self) -> None: ...
    def pd_config(self) -> Dict[str, Any]: ...
    def check_pd_config(self) -> bool: ...
    def restore_pd_defaults(self, write_nvm: bool = False) -> None: ...
    def on_fault(self, fn: _F) -> _F: ...
    def on_clear(self, fn: _F) -> _F: ...
    @property
    def faults(self) -> List[Fault]: ...
    def _held(self, code: str, cond: Any, t: float, seconds: float) -> bool: ...
    def poll(self) -> Snapshot: ...
    def _derive(self, s: Snapshot, t: float) -> None: ...
    def _check_settings(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_charger(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_battery(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_ts(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_power(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_pd(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _diagnose_pi(self, s: Snapshot, t: float, found: List[Any]) -> None: ...
    def _update_faults(self, s: Snapshot, found: List[Any], t: float) -> None: ...
    def run(
        self,
        interval_s: float = 2.0,
        callback: Optional[Callable[[Snapshot], Any]] = None,
        count: Optional[int] = None,
    ) -> None: ...
    def _load_state(self) -> None: ...
    def _save_state(self, clean: bool = False) -> None: ...
    def save_state(self, clean: bool = False) -> None: ...
    def acknowledge(self, code: str) -> None: ...
    def new_cells_fitted(self) -> None: ...
    def report(self, s: Optional[Snapshot] = None) -> str: ...

def _nearest_pd_voltage(v: float) -> Optional[float]: ...
