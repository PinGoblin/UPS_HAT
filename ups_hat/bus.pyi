from types import TracebackType
from typing import Iterable, List, Optional, Protocol, Type, Union

class I2CBus(Protocol):
    """Anything with MicroPython `machine.I2C` memory methods (type-checking only)."""

    def readfrom_mem(self, addr: int, reg: int, nbytes: int, /) -> bytes: ...
    def writeto_mem(self, addr: int, reg: int, buf: bytes, /) -> object: ...

class UPSError(Exception): ...
class DeviceNotFound(UPSError): ...
class BusError(UPSError): ...
class NotSupported(UPSError): ...

class LinuxI2C:
    I2C_SLAVE: int
    bus: int
    def __init__(self, bus: int = 1) -> None: ...
    def readfrom_mem(self, addr: int, reg: int, nbytes: int) -> bytes: ...
    def writeto_mem(self, addr: int, reg: int, buf: Union[bytes, bytearray, Iterable[int]]) -> None: ...
    def scan(self) -> List[int]: ...
    def close(self) -> None: ...
    def __enter__(self) -> "LinuxI2C": ...
    def __exit__(
        self,
        *exc: Union[Optional[Type[BaseException]], Optional[BaseException], Optional[TracebackType]],
    ) -> None: ...

def open_bus(bus: int = 1) -> LinuxI2C: ...

class I2CDevice:
    i2c: I2CBus
    address: int
    name: str
    def __init__(self, i2c: I2CBus, address: int, name: str = "device") -> None: ...
    def read(self, reg: int, n: int) -> bytes: ...
    def write(self, reg: int, data: Union[bytes, bytearray, Iterable[int]]) -> None: ...
    def u8(self, reg: int) -> int: ...
    def set_u8(self, reg: int, value: int) -> None: ...
    def u16be(self, reg: int) -> int: ...
    def s16be(self, reg: int) -> int: ...
    def set_u16be(self, reg: int, value: int) -> None: ...
    def u32le(self, reg: int) -> int: ...
    def set_u32le(self, reg: int, value: int) -> None: ...
    def field(self, reg: int, shift: int, width: int, wide: bool = False) -> int: ...
    def set_field(self, reg: int, shift: int, width: int, value: int, wide: bool = False) -> None: ...
    def bit(self, reg: int, n: int) -> bool: ...
    def set_bit(self, reg: int, n: int, on: bool) -> None: ...
    def present(self) -> bool: ...
